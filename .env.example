# Hermecious environment template.
# Copy to .env (git-ignored), then: chmod 600 .env
# Rules: docs/runbooks/secrets.md. Secret variables stay empty here; the
# subphase whose code first reads a variable adds it to this file.

# Deployment environment: development | test | production (required)
HERMECIOUS_ENV=development

# DEBUG | INFO | WARNING | ERROR. production rejects DEBUG.
HERMECIOUS_LOG_LEVEL=INFO

# Exact browser origins allowed to send cookie-authenticated mutations (comma-separated, no wildcards).
# Must match the web URL you open; production requires https:// origins.
HERMECIOUS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Session cookie: false only for local loopback HTTP (dev cookie name); production requires true.
HERMECIOUS_SESSION_COOKIE_SECURE=false

# Worker wake-up notifications: redis (default) | none. Jobs always live in Postgres (ADR-011).
HERMECIOUS_JOB_NOTIFY=redis

# Business timezone (blueprint §2 API conventions). Not a secret.
HERMECIOUS_TIMEZONE=Asia/Karachi

# --- Local Compose stack (P0.2; docs/runbooks/local-development.md) ---
# Compose builds DATABASE_URL and REDIS_URL for the api and worker from these.
POSTGRES_USER=hermecious
POSTGRES_DB=hermecious
# Required. Generate a URL-safe value: openssl rand -hex 32
POSTGRES_PASSWORD=

# Host ports, bound to 127.0.0.1 only. Change them on a port collision.
HERMECIOUS_API_PORT=8000
HERMECIOUS_WEB_PORT=3000
